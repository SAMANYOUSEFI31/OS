# ==========================================================
# Bushido Discipline OS - Environment Variables
# ==========================================================

# ---------- Database (PostgreSQL / Neon / Supabase / Vercel / Liara) ----------
# روی سیستم خودت می‌تواند localhost باشد.
# روی Vercel/لیارا باید Connection String واقعی سرویس Postgres را بگذاری.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"

# ---------- Security ----------
# حداقل ۳۲ کاراکتر — روی Vercel حتماً یک مقدار تصادفی قوی بگذار
JWT_SECRET="bushido_samurai_jwt_secret_key_2026_discipline_os_change_me"

# ادمین (روی Vercel همین نام‌ها را بساز)
SUPER_ADMIN_IDENTIFIER="09120000000"
SUPER_ADMIN_PHONE="09120000000"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASS="ChangeThisStrongPass123"
SUPER_ADMIN_NAME="فرمانده ارشد سامورایی"

# ---------- حالت تست (قبل از انتشار عمومی) ----------
# روی Vercel برای تست خودت و همکارها:
ALLOW_TEST_SHORTCUTS="true"
ENABLE_OTP_DEBUG="true"

# ---------- پرداخت ----------
# خالی = Mock (مناسب تست فعلی). بعداً MerchantId واقعی زرین‌پال را بگذار.
ZARINPAL_MERCHANT_ID=""

# ---------- App ----------
APP_URL="http://localhost:3000"

# ==========================================================
# Bushido Discipline OS - Environment Variables
# ==========================================================

# PostgreSQL Database Connection String (for Prisma ORM & Vercel / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bushido_db?schema=public"

# JWT Secret key for user authentication tokens
JWT_SECRET="bushido_samurai_jwt_secret_key_2026_discipline_os"

# Optional: Real Zarinpal Merchant ID (for live production payments)
# If empty, the built-in mock payment simulator will operate seamlessly.
ZARINPAL_MERCHANT_ID=""

# Application Host URL (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"
